# Chave de acesso ao painel administrativo (obrigatória).
ADMIN_PASSCODE=

# Opcional. Habilita o mapa interativo (Google Maps Embed API) nas páginas de imóvel.
# Sem essa chave, o site funciona normalmente e mostra um fallback visual com um
# botão "Abrir no Google Maps" — nenhum iframe quebrado é exibido.
#
# Como obter: https://developers.google.com/maps/documentation/embed/get-started
# Antes de usar em produção, restrinja a chave por domínio (HTTP referrer) no
# Google Cloud Console para evitar uso indevido por terceiros.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
